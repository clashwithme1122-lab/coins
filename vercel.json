{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "env": {
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyAulTxCpDy6_vjjSVfH7M1bVeaaoc1IJqs",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "taksi-275d2.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "taksi-275d2",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "taksi-275d2.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "751437476856",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:751437476856:web:c16c29782e20035e56dc0d",
    "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "G-0X73DJC39Z"
  }
}
